# Upload-Ordner: hier dürfen nur Bilder/Dokumente liegen, niemals ausführbare Skripte.
# Zweite Verteidigungslinie, falls trotz Prüfung eine Skriptdatei hochgeladen wird.
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|shtml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
